VERSION="0.9.0"

# Return a package name that has been stripped of the dirname portion
# and any of the valid extensions (only):
pkgbase() {
  PKGRETURN=${1##*/}
  case "$PKGRETURN" in *.t[gblx]z)
    PKGRETURN=${PKGRETURN%.*}
  esac
  echo "$PKGRETURN"
}

package_element() {
  STRING=$(pkgbase "$1")
  ELEMENT=$2
  case "$STRING" in
  *-*-*-*)
    # At least four segments, so we'll consider this a new-style name:
    case "$ELEMENT" in
    'name' )
      echo "${STRING%-*-*-*}"
      ;;
    'version' )
      STRING=${STRING%-*-*}
      echo "${STRING##*-}"
      ;;
    'arch' )
      STRING=${STRING%-*}
      echo "${STRING##*-}"
      ;;
    * )
      echo "${STRING##*-}"
      ;;
    esac
    ;;
  *)
    # Old style package name with one segment or we don't have four
    # segments: return the old-style (or out of spec) package name.
    if [ "$ELEMENT" = "name" ]; then
      echo "$STRING"
    else
      echo ""
    fi
  esac
}

clean_filename() {
  if [ -e "$1" -o -L "$1" ]; then
    EXTRAINFO=$(echo $1 | sed "s|^$WORKING_DIR||")
    EXTRAINFO=$(echo $EXTRAINFO | sed "s|\/\/|\/|g")
  else
    EXTRAINFO="$1"
  fi

  echo $EXTRAINFO
}

# Return a path within the package as it will be installed, no matter if it
# was given relative to the working directory, the package root or as listed
# in the package:
package_path() {
  PKGPATH=${1#"$WORKING_DIR"}
  while [[ $PKGPATH == *//* ]]; do
    PKGPATH=${PKGPATH//\/\//\/}
  done
  PKGPATH=${PKGPATH#./}
  PKGPATH=${PKGPATH%/}
  echo "/${PKGPATH#/}"
}

# Return whether messages with the given identifier are excluded from the
# output:
message_excluded() {
  local id

  for id in $IGNORE; do
    if [ -n "$1" -a "$id" = "$1" ]; then
      return 0
    fi
  done

  return 1
}

# Load the overrides for the current package. If the package ships its own
# overrides file, only that is used, otherwise the one shipped with lintpkg:
load_overrides() {
  local file line id arg
  local reason=""
  local previous=""

  OVERRIDE_IDS=()
  OVERRIDE_ARGS=()
  OVERRIDE_PATHS=()
  OVERRIDE_REASONS=()
  OVERRIDE_USED=()
  OVERRIDE_SOURCE=""

  file="$WORKING_DIR/usr/share/lintpkg/overrides/$PKG_NAME"

  if [ -f "$file" ] && ! [ -L "$file" ]; then
    OVERRIDE_SOURCE="package"
  elif [ -n "$OVERRIDES" ] && [ -f "$OVERRIDES/$PKG_NAME" ]; then
    file="$OVERRIDES/$PKG_NAME"
    OVERRIDE_SOURCE="lintpkg"
  else
    return
  fi

  while IFS= read -r line || [ -n "$line" ]; do
    # Strip leading and trailing whitespace:
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"

    if [ -z "$line" ]; then
      # An empty line ends the scope of a comment:
      reason=""
      previous=""
    elif [ "${line:0:1}" = "#" ]; then
      # A comment explains the overrides directly following it:
      if [ "$previous" = "override" ]; then
        reason=""
      fi

      while [ "${line:0:1}" = "#" ]; do
        line="${line:1}"
      done
      line="${line#"${line%%[![:space:]]*}"}"

      reason="${reason:+$reason }$line"
      previous="comment"
    else
      id="${line%%[[:space:]]*}"
      arg="${line#"$id"}"
      arg="${arg#"${arg%%[![:space:]]*}"}"

      OVERRIDE_IDS+=("$id")
      OVERRIDE_ARGS+=("$arg")
      OVERRIDE_PATHS+=("$(package_path "$arg")")
      OVERRIDE_REASONS+=("$reason")
      OVERRIDE_USED+=("no")
      previous="override"
    fi
  done < "$file"
}

# Return whether a message is overridden for the current package, and remember
# the override that matched. Messages about a path are only matched by
# overrides for that path. Other messages are matched by overrides without an
# argument, or with the same first argument:
message_overridden() {
  local kind="$1"
  local id="$2"
  local arg="$3"
  local n

  for n in "${!OVERRIDE_IDS[@]}"; do
    if ! [ "${OVERRIDE_IDS[$n]}" = "$id" ]; then
      continue
    fi

    if [ "$kind" = "path" ]; then
      if [ -z "${OVERRIDE_ARGS[$n]}" ] || ! [ "${OVERRIDE_PATHS[$n]}" = "$arg" ]; then
        continue
      fi
    elif [ -n "${OVERRIDE_ARGS[$n]}" ] && ! [ "${OVERRIDE_ARGS[$n]}" = "$arg" ]; then
      continue
    fi

    OVERRIDE_USED[$n]="yes"
    OVERRIDE_MATCH=$n
    return 0
  done

  return 1
}

# Log a message with the given level (E, W or I) and kind ("path" for messages
# about a path within the package, empty otherwise), followed by the message
# identifier and any additional information:
log_message() {
  local level="$1"
  local kind="$2"
  local overridden="no"
  shift 2

  if message_overridden "$kind" "$1" "$2"; then
    overridden="yes"
  fi

  if message_excluded "$1"; then
    return
  fi

  if [ "$overridden" = "yes" ]; then
    if [ "$level" = "E" ]; then
      OVERRIDDEN_ERRORS=$((OVERRIDDEN_ERRORS + 1))
    elif [ "$level" = "W" ]; then
      OVERRIDDEN_WARNINGS=$((OVERRIDDEN_WARNINGS + 1))
    else
      OVERRIDDEN_NOTICES=$((OVERRIDDEN_NOTICES + 1))
    fi

    if [ "$SHOW_OVERRIDES" = "yes" ]; then
      print_message "O" "$@"

      if [ -n "${OVERRIDE_REASONS[$OVERRIDE_MATCH]}" ]; then
        echo "  Overridden by $OVERRIDE_SOURCE: ${OVERRIDE_REASONS[$OVERRIDE_MATCH]}"
      else
        echo "  Overridden by $OVERRIDE_SOURCE"
      fi

      if [ "$INFO" = "yes" ]; then
        explain "$1"
      fi
    fi

    return
  fi

  if ! [ "$PKG_FULLNAME" = "(none)" ]; then
    if [ "$level" = "E" ]; then
      ERRORS=$((ERRORS + 1))
    elif [ "$level" = "W" ]; then
      WARNINGS=$((WARNINGS + 1))
    fi
  fi

  print_message "$level" "$@"

  if [ "$INFO" = "yes" ]; then
    explain "$1"
  fi
}

# Print a message with the given level, followed by the message identifier
# and any additional information:
print_message() {
  local level="$1"
  local arg
  shift

  echo -n "$PKG_FULLNAME: $level:"
  for arg in "$@"; do
    echo -n " $(clean_filename "$arg")"
  done
  echo ""
}

log_error() {
  log_message "E" "" "$@"
}

log_warning() {
  log_message "W" "" "$@"
}

log_notice() {
  log_message "I" "" "$@"
}

# Log a message about a file or directory within the package. The path is
# passed as the first argument after the message identifier:
log_path_error() {
  log_message "E" "path" "$1" "$(package_path "$2")" "${@:3}"
}

log_path_warning() {
  log_message "W" "path" "$1" "$(package_path "$2")" "${@:3}"
}

log_path_notice() {
  log_message "I" "path" "$1" "$(package_path "$2")" "${@:3}"
}

# Like rpmlint, report packages that can't be read without a message
# identifier, but still count them as errors:
log_read_error() {
  PKG_FULLNAME="(none)"
  log_error "error while reading $(realpath "$1"): $2"
  ERRORS=$((ERRORS + 1))
}

# Print the explanation for a message identifier. Checks provide explanations
# for their messages with an info() function, which is only defined while the
# check is loaded. Explanations for lintpkg's own messages come from
# local_info():
explain() {
  if declare -F info > /dev/null; then
    info "$1"
  fi

  local_info "$1"
}

local_info() {
  if [ "$1" = "external-compression-utility-missing" ]; then
    echo "The necessary compression utility for uncompressing the package is missing."
    echo
  fi
}

provides() {
  if ! [ -z "$(explain "$1")" ]; then
    echo "yes"
  else
    echo "no"
  fi
}

usage() {
  cat << EOF
Usage: lintpkg [options] <package_filename>

Lintpkg is used to verify a .t{gz,bz,lz,xz} package against a set of common
rules and guidelines for Slackware packaging.

  lintpkg slackware-package-1.0.0-x86_64-1.txz (or .tgz, .tbz, .tlz)

Options:
  -i, --info                Display explanations for reported messages.
  -I, --explain <messageid> Display explanations for the specified message
                            identifiers and exit. Multiple identifiers can be
                            specified by separating them with commas.
  -c, --check <name>        Run only the specified check. This option may be
                            given multiple times to specify multiple checks to
                            run.
  -C, --checkdir <path>     Specify path to load checks from.
  -h, --help                Display summary of command line options and exit.
  -E, --extractdir <path>   Base directory for extracted temporary files.
      --overridedir <path>  Specify path to load overrides from, if the
                            package doesn't ship its own.
      --show-overrides      Show overridden messages, and why they were
                            overridden.
  -V, --version             Display version information and exit.
  -x, --exclude <messageid> Don't show/count errors for the specified message
                            identifiers. Multiple identifiers can be specified
                            by separating them with commas.
EOF
}

version() {
  echo "lintpkg version $VERSION"
}

show_info() {
  stack=$(echo $1 | tr , '\n' | sort)

  for id in $stack; do
    for check in $(ls $CHECKS); do
      source "$CHECKS/$check"
      left=""

      if [ "$(provides $id)" = "yes" ]; then
        echo "$id:"
        explain "$id"
      else
        left="$id"
      fi

      unset -f check
      unset -f info

      if [ -z "$left" ]; then
        break
      fi
    done

    if ! [ -z "$left" ]; then
      echo "$id:"
    fi
  done
}

perform() {
  if [ -z "$1" ]; then
    LIST="$(ls $CHECKS)"
  else
    LIST="$1"
  fi

  for check in $LIST; do
    if [ -e "$CHECKS/$check.sh" ]; then
      check="$check.sh"
    fi

    source "$CHECKS/$check"
    check

    unset -f check
    unset -f info
  done

}

# usage(), exit if called with no arguments:
if [ $# = 0 ]; then
  usage;
  exit
fi

APPLICATION_DIR=$(dirname $(realpath $0))
WORKING_DIR=""
CWD=$(pwd)

INFO="no"
SHOW_OVERRIDES="no"
CHECKS=""
LIST=""
IGNORE=""

# Prefer the files next to the lintpkg script, so that running it from a git
# checkout uses the checkout's checks even if lintpkg is installed:
if [ -d "$APPLICATION_DIR/checks" ]; then
  DATA_DIR="$APPLICATION_DIR"
else
  DATA_DIR="/usr/share/lintpkg"
fi

if [ -e "$DATA_DIR/checks" ]; then
  CHECKS="$DATA_DIR/checks"
fi

OVERRIDES="$DATA_DIR/overrides"

while [ 0 ]; do
  if [ "$1" = "-I" -o "$1" = "--explain" ]; then
    if [ -z "$2" -o "$(echo $2 | head -c 1)" = "-" ]; then
      usage
      exit
    fi
    show_info $2
    exit 0
  elif [ "$1" = "-i" -o "$1" = "--info" ]; then
    INFO="yes"
    shift 1
  elif [ "$1" = "-h" -o "$1" = "--help" ]; then
    usage
    exit
  elif [ "$1" = "-V" -o "$1" = "--version" ]; then
    version
    exit
  elif [ "$1" = "-c" -o "$1" = "--check" ]; then
    if [ -z "$2" -o "$(echo $2 | head -c 1)" = "-" ]; then
      usage
      exit
    fi

    LIST="$LIST $2";
    shift 2
  elif [ "$1" = "-C" -o "$1" = "--checkdir" ]; then
    if [ -z "$2" -o "$(echo $2 | head -c 1)" = "-" ]; then
      usage
      exit
    fi

    if ! [ -e "$2" ]; then
      echo "Directory does not exist: $2"
      CHECKS=""
    else
      CHECKS="$(realpath "$2")"
    fi

    shift 2
  elif [ "$1" = "--show-overrides" ]; then
    SHOW_OVERRIDES="yes"
    shift 1
  elif [ "$1" = "--overridedir" ]; then
    if [ -z "$2" -o "$(echo $2 | head -c 1)" = "-" ]; then
      usage
      exit
    fi

    if ! [ -e "$2" ]; then
      echo "Directory does not exist: $2"
      exit 1
    fi

    OVERRIDES="$(realpath "$2")"
    shift 2
  elif [ "$1" = "-E" -o "$1" = "--extractdir" ]; then
    if [ -z "$2" -o "$(echo $2 | head -c 1)" = "-" ]; then
      usage
      exit
    fi

    if [ -e "$2" ]; then
      WORKING_DIR="$(realpath "$2")"
    else
      echo "Directory does not exist: $2"
      exit
    fi

    shift 2
  elif [ "$1" = "-x" -o "$1" = "--exclude" ]; then
    if [ -z "$2" -o "$(echo $2 | head -c 1)" = "-" ]; then
      usage
      exit
    fi

    IGNORE=$(echo $2 | tr , '\n')
    shift 2
  else
    break
  fi
done

if [ -z "$WORKING_DIR" ]; then
  WORKING_DIR=$(mktemp -d -t lintpkg.XXXXXX)
else
  WORKING_DIR=$(mktemp -d -p "$WORKING_DIR" -t lintpkg.XXXXXX 2> /dev/null)
fi

if [ -z "$WORKING_DIR" ]; then
  echo "Couldn't create temporary directory"
  exit 1
fi

if [ -z "$CHECKS" -o -z "$(ls -1 $CHECKS)" ]; then
  echo "No lint checks found!"
  exit 1
fi

# Uncompressed package contents, so that packages only need to be
# decompressed once:
PKG_TARBALL=$(mktemp -p "$(dirname "$WORKING_DIR")" lintpkg.XXXXXX.tar 2> /dev/null)

if [ -z "$PKG_TARBALL" ]; then
  echo "Couldn't create temporary file"
  rm -rf $WORKING_DIR
  exit 1
fi

ERRORS=0
WARNINGS=0
PACKAGES=0
OVERRIDDEN_ERRORS=0
OVERRIDDEN_WARNINGS=0
OVERRIDDEN_NOTICES=0

for PACKAGE in "$@"; do

  PKG_FULLNAME="(none)"
  OVERRIDE_IDS=()

  if ! [ -e "$PACKAGE" ]; then
    log_error "No package found with name $PACKAGE"
    continue
  fi

  PKG_NAME=$(package_element "$PACKAGE" name)
  PKG_VERSION=$(package_element "$PACKAGE" version)
  PKG_ARCH=$(package_element "$PACKAGE" arch)
  PKG_BUILD=$(package_element "$PACKAGE" build)
  PKG_EXTENSION=${PACKAGE##*.}
  PKG_FULLNAME=$(pkgbase "$PACKAGE")

  # Determine compressor utility, preferring ones that use multiple
  # decompression threads:
  case $PKG_EXTENSION in
    'tgz' )
      packagecompression=gzip
      ;;
    'tbz' )
      if command -v lbzip2 1> /dev/null 2> /dev/null ; then
        packagecompression=lbzip2
      else
        packagecompression=bzip2
      fi
      ;;
    'tlz' )
      if command -v plzip 1> /dev/null 2> /dev/null ; then
        packagecompression=plzip
      else
        packagecompression=lzip
      fi
      ;;
    'txz' )
      packagecompression="xz --threads=0"
      ;;
    * )
      log_read_error "$PACKAGE" "file does not end in .tgz, .tbz, .tlz, or .txz"
      continue
      ;;
  esac

  # Test presence of external compression utility:
  compressor=$(echo $packagecompression | cut -f 1 -d ' ')
  if ! $compressor --help 1> /dev/null 2> /dev/null ; then
    log_notice "external-compression-utility-missing" "$compressor"
    continue
  fi

  if ! READ_ERROR=$($packagecompression -dc < "$PACKAGE" 2>&1 > $PKG_TARBALL) ||
    ! READ_ERROR=$(tar tf $PKG_TARBALL 2>&1 > /dev/null); then
    log_read_error "$PACKAGE" "$(echo "$READ_ERROR" | head -n 1)"
    continue
  fi

  PKG_LISTING=$(tar tsf $PKG_TARBALL)
  PKG_DETAILED_LISTING=$(tar tvsf $PKG_TARBALL)

  cd $WORKING_DIR

    ( umask 000 ; tar --acls --xattrs --xattrs-include='*' -xf $PKG_TARBALL 2> /dev/null )

    load_overrides

    perform "$LIST"

    PACKAGES=$((PACKAGES + 1))

  cd $CWD

  rm -rf "$WORKING_DIR/"*
done

SUMMARY="$PACKAGES packages checked; $ERRORS errors and $WARNINGS warnings"

if [ $((OVERRIDDEN_ERRORS + OVERRIDDEN_WARNINGS + OVERRIDDEN_NOTICES)) -gt 0 ]; then
  SUMMARY="$SUMMARY; $OVERRIDDEN_ERRORS errors, $OVERRIDDEN_WARNINGS warnings"
  SUMMARY="$SUMMARY and $OVERRIDDEN_NOTICES notices overridden"
fi

echo "$SUMMARY."

rm -rf $WORKING_DIR
rm -f $PKG_TARBALL

if [ $ERRORS -gt 0 -o $WARNINGS -gt 0 ]; then
  exit 64
else
  exit 0
fi
