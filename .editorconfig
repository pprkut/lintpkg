# https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# Globs containing a path only match relative to this file, so tests/run
# can't be part of the glob for files in any directory:
[{*.sh,*.bash,*.bats,lintpkg,*.yml,*.yaml}]
indent_style = space
indent_size = 2

[tests/run]
indent_style = space
indent_size = 2

[{*.c,*.h}]
indent_style = space
indent_size = 4

[*.md]
indent_style = space

[*.toml]
indent_style = space
indent_size = 4
