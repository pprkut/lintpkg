# https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# Globs containing a path only match relative to this file, so tests/run
# can't be part of the glob for files in any directory:
[{*.sh,*.bash,*.bats,lintpkg,*.yml,*.yaml}]
indent_style = space
indent_size = 2

# Formatting options for shfmt. Checks are sourced by lintpkg, so they're
# always bash, whatever their shebang says:
[{*.sh,*.bash,lintpkg}]
shell_variant = bash
space_redirects = true

[*.bats]
shell_variant = bats
space_redirects = true

[tests/run]
indent_style = space
indent_size = 2
shell_variant = bash
space_redirects = true

# Test fixtures whose content is checked by the test suite, and generated
# files, are not formatted by shfmt:
[{tests/statics/**,build/**}]
ignore = true

[{*.c,*.h}]
indent_style = space
indent_size = 4

[*.md]
indent_style = space

[*.toml]
indent_style = space
indent_size = 4
